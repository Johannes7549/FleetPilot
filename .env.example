# Copy to .env and adjust. Never commit .env.

# --- Database -------------------------------------------------------------------
# Docker Compose sets FLEETPILOT_DATABASE_URL for the backend container automatically.
# For running the backend on your host against the compose Postgres:
FLEETPILOT_DATABASE_URL=postgresql+psycopg://fleetpilot:fleetpilot@localhost:5432/fleetpilot
# Zero-dependency local alternative:
# FLEETPILOT_DATABASE_URL=sqlite:///./backend/fleetpilot_dev.db
POSTGRES_USER=fleetpilot
POSTGRES_PASSWORD=fleetpilot
POSTGRES_DB=fleetpilot

# --- LLM (optional) ---------------------------------------------------------------
# deterministic | anthropic | openai.  "deterministic" needs no key. If a provider is chosen but its key is
# missing, the app runs in *deterministic fallback* mode and says so (header badge, Settings, /api/system/llm-status,
# every run's `execution` block) — it never claims LLM mode it is not in.
FLEETPILOT_LLM_PROVIDER=deterministic
# FLEETPILOT_LLM_MODEL=claude-opus-5-5        # default for anthropic; gpt-4o-mini for openai
# all  = LLM plans, reviews tool results (follow-up steps) and phrases answers  -> "LLM-powered" mode
# plan = LLM plans and reviews; answers composed deterministically               -> "Hybrid" mode
FLEETPILOT_LLM_STAGES=all
# Anthropic output_config.effort (low|medium|high); leave empty for models that do not support it
FLEETPILOT_LLM_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FLEETPILOT_LLM_TIMEOUT_SECONDS=30
FLEETPILOT_LLM_MAX_RETRIES=2                 # SDK retries with backoff for 429 / 5xx / connection errors

# --- Agent ------------------------------------------------------------------------
FLEETPILOT_AGENT_MAX_TOOL_CALLS=8
FLEETPILOT_AGENT_MAX_REPLANS=2
FLEETPILOT_TOOL_TIMEOUT_SECONDS=10

# --- Actions / approvals -------------------------------------------------------------
FLEETPILOT_APPROVAL_TTL_HOURS=72
# true = the admin who approves must differ from the user who proposed
FLEETPILOT_REQUIRE_DISTINCT_APPROVER=false

# --- API / security -----------------------------------------------------------------
FLEETPILOT_ENVIRONMENT=development      # "production" disables the demo login endpoints
FLEETPILOT_AUTH_SECRET=change-me-in-production
FLEETPILOT_CORS_ORIGINS=http://localhost:3000
FLEETPILOT_RATE_LIMIT_PER_MINUTE=60
